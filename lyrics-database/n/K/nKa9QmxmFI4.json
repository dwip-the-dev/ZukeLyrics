  "rawTtml": "<tt xmlns=\"http:\/\/www.w3.org\/ns\/ttml\" xmlns:ttm=\"http:\/\/www.w3.org\/ns\/ttml#metadata\">\n  <body>\n    <div>\n      <p begin=\"00:20.160\" end=\"00:23.970\">\n        <span begin=\"00:20.160\" end=\"00:21.332\">In <\/span>\n        <span begin=\"00:21.332\" end=\"00:22.504\">my <\/span>\n        <span begin=\"00:22.504\" end=\"00:23.970\">world<\/span>\n      <\/p>\n      <p begin=\"00:23.970\" end=\"00:27.530\">\n        <span begin=\"00:23.970\" end=\"00:25.220\">보이지 <\/span>\n        <span begin=\"00:25.220\" end=\"00:26.374\">않는 <\/span>\n        <span begin=\"00:26.374\" end=\"00:27.530\">곳에<\/span>\n      <\/p>\n      <p begin=\"00:27.530\" end=\"00:35.780\">\n        <span begin=\"00:27.530\" end=\"00:29.918\">그 <\/span>\n        <span begin=\"00:29.918\" end=\"00:32.740\">곳에서 <\/span>\n        <span begin=\"00:32.740\" end=\"00:35.780\">살고있지<\/span>\n      <\/p>\n      <p begin=\"00:35.780\" end=\"00:39.230\">\n        <span begin=\"00:35.780\" end=\"00:36.841\">In <\/span>\n        <span begin=\"00:36.841\" end=\"00:37.902\">my <\/span>\n        <span begin=\"00:37.902\" end=\"00:39.230\">world<\/span>\n      <\/p>\n      <p begin=\"00:39.230\" end=\"00:50.970\">\n        <span begin=\"00:39.230\" end=\"00:41.161\">언제나 <\/span>\n        <span begin=\"00:41.161\" end=\"00:42.944\">환한 <\/span>\n        <span begin=\"00:42.944\" end=\"00:44.875\">미소로 <\/span>\n        <span begin=\"00:44.875\" end=\"00:46.806\">날보며 <\/span>\n        <span begin=\"00:46.806\" end=\"00:48.886\">웃어주던 <\/span>\n        <span begin=\"00:48.886\" end=\"00:50.970\">사람들과<\/span>\n      <\/p>\n      <p begin=\"00:50.970\" end=\"00:54.790\">\n        <span begin=\"00:50.970\" end=\"00:52.116\">So <\/span>\n        <span begin=\"00:52.116\" end=\"00:53.548\">Let&apos;s <\/span>\n        <span begin=\"00:53.548\" end=\"00:54.790\">Fly<\/span>\n      <\/p>\n      <p begin=\"00:54.790\" end=\"00:59.030\">\n        <span begin=\"00:54.790\" end=\"00:55.953\">Just <\/span>\n        <span begin=\"00:55.953\" end=\"00:57.033\">You <\/span>\n        <span begin=\"00:57.033\" end=\"00:58.113\">And <\/span>\n        <span begin=\"00:58.113\" end=\"00:59.030\">I<\/span>\n      <\/p>\n      <p begin=\"00:59.030\" end=\"01:02.340\">\n        <span begin=\"00:59.030\" end=\"01:00.742\">Don&apos;t <\/span>\n        <span begin=\"01:00.742\" end=\"01:02.340\">Cry~<\/span>\n      <\/p>\n      <p begin=\"01:02.340\" end=\"01:06.280\">\n        <span begin=\"01:02.340\" end=\"01:03.267\">No <\/span>\n        <span begin=\"01:03.267\" end=\"01:04.116\">I <\/span>\n        <span begin=\"01:04.116\" end=\"01:05.274\">don&apos;t <\/span>\n        <span begin=\"01:05.274\" end=\"01:06.280\">Cry<\/span>\n      <\/p>\n      <p begin=\"01:06.280\" end=\"01:13.960\">\n        <span begin=\"01:06.280\" end=\"01:07.406\">난 <\/span>\n        <span begin=\"01:07.406\" end=\"01:08.737\">이렇게 <\/span>\n        <span begin=\"01:08.737\" end=\"01:09.965\">항상 <\/span>\n        <span begin=\"01:09.965\" end=\"01:11.398\">니곁에서 <\/span>\n        <span begin=\"01:11.398\" end=\"01:12.626\">노래 <\/span>\n        <span begin=\"01:12.626\" end=\"01:13.960\">부를래<\/span>\n      <\/p>\n      <p begin=\"01:13.960\" end=\"01:22.210\">\n        <span begin=\"01:13.960\" end=\"01:15.356\">넌 <\/span>\n        <span begin=\"01:15.356\" end=\"01:17.006\">그렇게 <\/span>\n        <span begin=\"01:17.006\" end=\"01:18.909\">지금처럼만 <\/span>\n        <span begin=\"01:18.909\" end=\"01:20.305\">날 <\/span>\n        <span begin=\"01:20.305\" end=\"01:22.210\">바라봐줄래<\/span>\n      <\/p>\n      <p begin=\"01:22.210\" end=\"01:25.770\">\n        <span begin=\"01:22.210\" end=\"01:22.873\">나 <\/span>\n        <span begin=\"01:22.873\" end=\"01:23.597\">눈을 <\/span>\n        <span begin=\"01:23.597\" end=\"01:24.321\">감는 <\/span>\n        <span begin=\"01:24.321\" end=\"01:24.984\">그 <\/span>\n        <span begin=\"01:24.984\" end=\"01:25.770\">날에도<\/span>\n      <\/p>\n      <p begin=\"01:25.770\" end=\"01:41.400\">\n        <span begin=\"01:25.770\" end=\"01:28.339\">다시 <\/span>\n        <span begin=\"01:28.339\" end=\"01:30.908\">태어 <\/span>\n        <span begin=\"01:30.908\" end=\"01:33.263\">난 <\/span>\n        <span begin=\"01:33.263\" end=\"01:35.832\">대도 <\/span>\n        <span begin=\"01:35.832\" end=\"01:38.401\">너와 <\/span>\n        <span begin=\"01:38.401\" end=\"01:41.400\">(워~)<\/span>\n      <\/p>\n      <p begin=\"01:41.400\" end=\"01:45.530\">\n        <span begin=\"01:41.400\" end=\"01:42.670\">In <\/span>\n        <span begin=\"01:42.670\" end=\"01:43.940\">my <\/span>\n        <span begin=\"01:43.940\" end=\"01:45.530\">world<\/span>\n      <\/p>\n      <p begin=\"01:45.530\" end=\"01:52.090\">\n        <span begin=\"01:45.530\" end=\"01:47.657\">너를 <\/span>\n        <span begin=\"01:47.657\" end=\"01:50.139\">감싸안은 <\/span>\n        <span begin=\"01:50.139\" end=\"01:52.090\">채<\/span>\n      <\/p>\n      <p begin=\"01:52.090\" end=\"01:57.090\">\n        <span begin=\"01:52.090\" end=\"01:57.090\">(Miao)<\/span>\n      <\/p>\n    <\/div>\n  <\/body>\n<\/tt>",
